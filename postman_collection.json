{
  "info": {
    "name": "Waste Collection API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "household_id",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "pickup_id",
      "value": ""
    },
    {
      "key": "payment_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Households",
      "item": [
        {
          "name": "Create Household",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner_name\": \"Test User\",\n  \"address\": \"Jl. Test No. 1\"\n}"
            },
            "url": "{{base_url}}/api/households"
          }
        },
        {
          "name": "List Households",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/households?page=1&limit=10"
          }
        },
        {
          "name": "Get Household",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/households/{{household_id}}"
          }
        },
        {
          "name": "Delete Household",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/households/{{household_id}}"
          }
        }
      ]
    },
    {
      "name": "Pickups",
      "item": [
        {
          "name": "Create Pickup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"household_id\": \"{{household_id}}\",\n  \"type\": \"organic\"\n}"
            },
            "url": "{{base_url}}/api/pickups"
          }
        },
        {
          "name": "List Pickups",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/pickups?status=pending&page=1&limit=10"
          }
        },
        {
          "name": "Schedule Pickup",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup_date\": \"2026-10-20T10:00:00Z\"\n}"
            },
            "url": "{{base_url}}/api/pickups/{{pickup_id}}/schedule"
          }
        },
        {
          "name": "Complete Pickup",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/pickups/{{pickup_id}}/complete"
          }
        },
        {
          "name": "Cancel Pickup",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/pickups/{{pickup_id}}/cancel"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"household_id\": \"{{household_id}}\",\n  \"waste_id\": \"{{pickup_id}}\",\n  \"amount\": 50000\n}"
            },
            "url": "{{base_url}}/api/payments"
          }
        },
        {
          "name": "List Payments",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/payments?status=pending&page=1&limit=10"
          }
        },
        {
          "name": "Confirm Payment",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "proof_file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": "{{base_url}}/api/payments/{{payment_id}}/confirm"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Waste Summary",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/reports/waste-summary"
          }
        },
        {
          "name": "Payment Summary",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/reports/payment-summary"
          }
        }
      ]
    }
  ]
}
